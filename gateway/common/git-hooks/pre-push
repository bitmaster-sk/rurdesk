#!/bin/bash
# Reject pushes to branches that don't match the agent pattern.
while read local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  if ! [[ "$branch" =~ ^agent/a[0-9]+/i[0-9]+/[0-9]+$ ]]; then
    echo "ERROR: Branch '$branch' rejected."
    echo "Agent branches must match: agent/a<agentId>/i<issueId>/<timestamp>"
    echo "This is a local pre-push hook (.git/hooks/pre-push), not a server rule."
    exit 1
  fi
done

# Reject a push from any checkout other than the run's worktree, e.g. the main
# clone it sits in. The gateway sets RURDESK_WORKTREE for the agent process only.
if [ -n "$RURDESK_WORKTREE" ]; then
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"
  pushing="$(cd "$toplevel" 2>/dev/null && pwd -P)"
  expected="$(cd "$RURDESK_WORKTREE" 2>/dev/null && pwd -P)"
  if [ -z "$pushing" ] || [ "$pushing" != "$expected" ]; then
    echo "ERROR: Push from '${toplevel:-$PWD}' rejected."
    echo "Your worktree is '$RURDESK_WORKTREE'. Commit and push from there; the repository around it is not yours."
    echo "This is a local pre-push hook (.git/hooks/pre-push), not a server rule."
    exit 1
  fi
fi
exit 0
