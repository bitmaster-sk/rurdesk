# Claude Code gateway of Agent 010 → Claude Console account (http://gateway-agent-010:9090).

####################################################################################
# GATEWAY
####################################################################################
# Gateway listen port. Default: 9090
#LISTEN_PORT=

# Log level for the gateway. Options: debug, info, warn, error. Default: info
LOG_LEVEL=debug

####################################################################################
# TRACKER
####################################################################################
# Tracker URL (http://rurdesk.proxy)
TRACKER_URL=http://rurdesk.proxy

# Token for the gateway to authenticate with the tracker.
# Obtained when creating bot user in the tracker.
GATEWAY_TO_TRACKER_TOKEN=<agent-010: from-tracker-admin-ui>

# Token for the tracker to authenticate with the gateway.
# Obtained when creating bot user in the tracker.
TRACKER_TO_GATEWAY_TOKEN=<agent-010: hex-32-byte-token-shown-on-gateway-create>

####################################################################################
# CLAUDE CODE (AI AGENT)
####################################################################################
# Models this gateway lets the tracker pick, as bare Claude Code model names
# (no provider/ prefix). The first is the default unless MODEL_DEFAULT names
# another one.
MODELS=sonnet,opus,haiku

#MODEL_DEFAULT=sonnet

# Claude Console auth (Claude subscriptions are not supported), one of:
#  a) An API key from the Claude Console (API Keys), scoped to a workspace — set it here.
#  b) Leave it unset and seed the gateway-agent-010-creds volume once with an
#     interactive Console login: docker exec -it gateway_agent_010 claude
# ANTHROPIC_API_KEY is never used: the adapter strips it from the agent env.
CLAUDE_CODE_OAUTH_TOKEN=<claude-setup-token>

# Live thinking text: summarized | omitted. Default: summarized
#CLAUDE_THINKING_DISPLAY=

# Highest turn limit the tracker may ask for. Unset means no ceiling.
#MAX_TURNS_LIMIT=1000
