# Goose gateway → Qwen (open-weight) via an external Ollama. Keyless (http://gateway-goose-qwen-local:9090).

####################################################################################
# GATEWAY
####################################################################################
# Gateway listen port. Default: 9090
LISTEN_PORT=9090

# Max concurrent runs. Default: 1
MAX_CONCURRENT=1

# Log level: debug, info, warn, error. Default: info
LOG_LEVEL=info

####################################################################################
# TRACKER
####################################################################################
# Tracker base URL.
TRACKER_URL=http://rurdesk.proxy

# Bot token — gateway authenticates to the tracker. From tracker admin UI.
GATEWAY_TO_TRACKER_TOKEN=<bot-qwen-local: from-tracker-admin-ui>

# Hex 32-byte token — verifies tracker webhook signatures. Shown on gateway create.
TRACKER_TO_GATEWAY_TOKEN=<bot-qwen-local: hex-32-byte-token-shown-on-gateway-create>

####################################################################################
# GIT
####################################################################################
# The single git remote this gateway works in, cloned into /worktrees.
# One repo per gateway: run another gateway with another bot for a second repo.
REPO_URL=https://github.com/your-org/your-repo.git

# PAT with contents read+write on REPO_URL. Only push is needed.
GIT_ACCESS_TOKEN=<git-pat>

####################################################################################
# GOOSE (AI AGENT)
####################################################################################
# Provider. ollama = keyless; the model must be pulled on OLLAMA_HOST. Default: anthropic
GOOSE_PROVIDER=ollama

# Model (must be pulled on OLLAMA_HOST). Provider default if unset.
GOOSE_MODEL=qwen3-coder

# External Ollama host. NOT localhost (that's the container); use host.docker.internal for the docker host.
OLLAMA_HOST=http://host.docker.internal:11434

# Hard --max-turns for non-implementation stages. Default: 50
GOOSE_MAX_TURNS_PLAN=50

# Hard --max-turns for the implementation stage. Default: 100
GOOSE_MAX_TURNS_IMPLEMENT=100
