# Goose gateway → Kimi K2.7 Code, Gitea repo (http://gateway-goose-kimi-gitea:9090).

####################################################################################
# GATEWAY
####################################################################################
# Gateway listen port. Default: 9090
#LISTEN_PORT=

# Log level for the gateway. Options: debug, info, warn, error. Default: info
LOG_LEVEL=debug

####################################################################################
# TRACKER
####################################################################################
# Tracker URL (http://rurdesk.proxy)
TRACKER_URL=http://rurdesk.proxy

# Token for the gateway to authenticate with the tracker.
# Obtained when creating bot user in the tracker. 
GATEWAY_TO_TRACKER_TOKEN=<bot-kimi-gitea: from-tracker-admin-ui>

# Token for the tracker to authenticate with the gateway.
# Obtained when creating bot user in the tracker.
TRACKER_TO_GATEWAY_TOKEN=<bot-kimi-gitea: hex-32-byte-token-shown-on-gateway-create>

####################################################################################
# GIT
####################################################################################
# The single git remote this gateway works in, cloned into /worktrees.
# One repo per gateway: run another gateway with another agent for a second repo.
REPO_URL=https://gitea.com/<owner>/<repo>.git

# Personal access token / app token with contents read+write on `REPO_URL`.
# Injected into the remote URL so the per-run agent can push branches back.
# Only **push** is needed.
GIT_ACCESS_TOKEN=<gitea-token-write:repository>

# Branch each per-run worktree starts from. Leave unset to use the repository's
# own default branch, read from the remote at startup. Set it only to target
# something else, e.g. develop.
#REPO_BRANCH_BASE=

####################################################################################
# GOOSE (AI AGENT)
####################################################################################
# Models this gateway lets the tracker pick, as provider/model. The first is the
# default unless MODEL_DEFAULT names another one.
MODELS=openai/glm-5.3,openai/kimi-k2.7-code,openai/mistral-large-4

#MODEL_DEFAULT=openai/kimi-k2.7-code

OPENAI_HOST=https://ollama.com

OPENAI_BASE_PATH=v1/chat/completions

OPENAI_API_KEY=<ollama-cloud-api-key>

# Highest turn limit the tracker may ask for. Unset means no ceiling.
#MAX_TURNS_LIMIT=1000
