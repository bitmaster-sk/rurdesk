# Goose gateway → Ollama Cloud via goose's OpenAI-compatible provider (http://gateway-goose-qwen-cloud:9090).

####################################################################################
# GATEWAY
####################################################################################
# Gateway listen port. Default: 9090
LISTEN_PORT=9090

# Max concurrent runs. Default: 1
MAX_CONCURRENT=1

# Log level: debug, info, warn, error. Default: info
LOG_LEVEL=debug

####################################################################################
# TRACKER
####################################################################################
# Tracker base URL.
TRACKER_URL=http://rurdesk.proxy

# Bot token — gateway authenticates to the tracker. From tracker admin UI.
GATEWAY_TO_TRACKER_TOKEN=<bot-qwen-cloud: from-tracker-admin-ui>

# Hex 32-byte token — verifies tracker webhook signatures. Shown on gateway create.
TRACKER_TO_GATEWAY_TOKEN=<bot-qwen-cloud: hex-32-byte-token-shown-on-gateway-create>

####################################################################################
# GIT
####################################################################################
# The single git remote this gateway works in, cloned into /worktrees.
# One repo per gateway: run another gateway with another bot for a second repo.
REPO_URL=https://github.com/your-org/your-repo.git

# PAT with contents read+write on REPO_URL. Only push is needed.
GIT_ACCESS_TOKEN=<git-pat>

####################################################################################
# GOOSE (AI AGENT)
####################################################################################
# Provider. openai-compat → Ollama Cloud /v1 (native ollama sends no auth → 401). Default: anthropic
GOOSE_PROVIDER=openai

# Model. Free w/ basic key: qwen3-coder:480b, gpt-oss:120b, gpt-oss:20b. Paid: kimi-k2.7-code, deepseek-v3.1:671b.
GOOSE_MODEL=qwen3-coder:480b

# OpenAI-compatible endpoint (Ollama Cloud).
OPENAI_HOST=https://ollama.com
OPENAI_BASE_PATH=v1/chat/completions

# API key from ollama.com/settings/keys.
OPENAI_API_KEY=<ollama-cloud-api-key>

# Hard --max-turns for non-implementation stages. Default: 250
GOOSE_MAX_TURNS_PLAN=250

# Hard --max-turns for the implementation stage. Default: 500
GOOSE_MAX_TURNS_IMPLEMENT=500
