# Single production image ("tracker"): the Go binary serves REST, WebSocket,
# the mounted MCP handler AND the Angular SPA on one port (no nginx, no separate
# client/proxy containers). Build context is the repo root.

################################################################
# Stage 1 — build the Angular production bundle
################################################################
FROM node:24.22.2-bookworm-slim AS client-build

WORKDIR /client

# Install deps against the lockfile first for layer caching.
COPY client/package*.json client/.npmrc ./
RUN npm ci

COPY client .
RUN npx ng build --configuration production --output-path=dist/production

################################################################
# Stage 2 — build the Go binary (+ goose for migrations)
################################################################
FROM golang:1.27.3-alpine AS api-build

# Release identity, stamped into the binary by script/build.sh. Empty in a
# plain `docker build`, which leaves the buildinfo dev defaults in place.
ARG VERSION
ARG COMMIT
# Selects the entrypoint package. It changes what the `api` binary contains; the
# runtime stage is identical either way.
ARG API_PACKAGE
# Our license public key (base64 of the raw 32-byte Ed25519 key), embedded in
# the commercial binary so it ignores LICENSE_PUBLIC_KEY from env. Empty for
# local and e2e builds. A release sets REQUIRE_LICENSE_PUBLIC_KEY=1 so a missing
# key fails the build instead of shipping an image that trusts env.
ARG EMBEDDED_LICENSE_PUBLIC_KEY
ARG REQUIRE_LICENSE_PUBLIC_KEY=0
ENV VERSION=${VERSION} \
    COMMIT=${COMMIT} \
    API_PACKAGE=${API_PACKAGE} \
    EMBEDDED_LICENSE_PUBLIC_KEY=${EMBEDDED_LICENSE_PUBLIC_KEY}

RUN if [ -n "$EMBEDDED_LICENSE_PUBLIC_KEY" ] \
        && [ "$(printf '%s' "$EMBEDDED_LICENSE_PUBLIC_KEY" | base64 -d 2>/dev/null | wc -c)" -ne 32 ]; then \
        echo "ERROR: EMBEDDED_LICENSE_PUBLIC_KEY must be base64 of a 32-byte Ed25519 public key" >&2; \
        exit 1; \
    fi \
 && if [ "$API_PACKAGE" = "./commercial/cmd/api" ] && [ "$REQUIRE_LICENSE_PUBLIC_KEY" = "1" ] \
        && [ -z "$EMBEDDED_LICENSE_PUBLIC_KEY" ]; then \
        echo "ERROR: EMBEDDED_LICENSE_PUBLIC_KEY is required for a commercial release build" >&2; \
        exit 1; \
    fi

RUN go install github.com/pressly/goose/v3/cmd/goose@v3.26.0

WORKDIR /app

COPY api/go.mod api/go.sum ./
RUN go mod download

COPY api ./
# A free image must not ship the commercial licence text, so the file is written
# here and the runtime stage copies it unconditionally.
RUN ./script/build.sh \
 && if [ "$API_PACKAGE" = "./commercial/cmd/api" ]; then \
        cp commercial/LICENSE /app/LICENSE.commercial; \
    else \
        echo "This build contains no commercial code; the root LICENSE (AGPL-3.0) covers all of it." \
            > /app/LICENSE.commercial; \
    fi

################################################################
# Stage 3 — minimal runtime, non-root
################################################################
FROM alpine:3.23.2

# wget (busybox) is used by the container HEALTHCHECK.
RUN addgroup -S app && adduser -S -G app app

WORKDIR /app

COPY --from=api-build /app/api /app/api
# admin maintenance CLI (e.g. `docker exec -it <container> admin rotate-git-key`)
COPY --from=api-build /app/admin /usr/local/bin/admin
COPY --from=api-build /app/migrations /app/migrations
COPY --from=api-build /app/script /app/script
COPY --from=api-build /go/bin/goose /usr/local/bin/goose
# The Angular `application` builder emits the browser bundle under browser/
# (alongside 3rdpartylicenses.txt / prerendered-routes.json). STATIC_DIR points
# at that subdirectory so index.html sits at its root.
COPY --from=client-build /client/dist/production/browser /app/public

# Copy the notice file with error handling. [t] is a workaround for Dockerfile syntax to make the COPY optional.
# The commercial image gets its own file, so the free one never lists commercial dependencies.
ARG REQUIRE_NOTICES=0
ARG API_PACKAGE
COPY THIRD_PARTY_NOTICES*.tx[t] /tmp/notices/
RUN notices=THIRD_PARTY_NOTICES.txt; \
    if [ "$API_PACKAGE" = "./commercial/cmd/api" ]; then notices=THIRD_PARTY_NOTICES.commercial.txt; fi; \
    if [ -f "/tmp/notices/$notices" ]; then \
        mv "/tmp/notices/$notices" /app/THIRD_PARTY_NOTICES.txt; \
    elif [ "$REQUIRE_NOTICES" = "1" ]; then \
        echo "ERROR: $notices is missing — run script/licenses.sh before building this image" >&2; \
        exit 1; \
    else \
        echo "Built without third-party notices. Not fit for distribution." > /app/THIRD_PARTY_NOTICES.txt; \
    fi \
 && rm -rf /tmp/notices
COPY LICENSE /app/
COPY --from=api-build /app/LICENSE.commercial /app/

# Production serves the SPA from the Go binary on the single application port.
ENV SERVE_STATIC=true \
    STATIC_DIR=/app/public \
    APPLICATION_HOST=0.0.0.0 \
    APPLICATION_PORT=1000

RUN chown -R app:app /app
USER app

EXPOSE 1000

# Liveness only, with a generous start period: the entrypoint runs Goose
# migrations before the server starts listening, so readiness/DB checks must not
# kill the container mid-migration.
HEALTHCHECK --interval=10s --timeout=3s --start-period=90s --retries=5 \
    CMD wget -qO- http://127.0.0.1:1000/healthz >/dev/null 2>&1 || exit 1

CMD ["./script/entrypoint.sh"]
