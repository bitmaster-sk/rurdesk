# Goose gateway of Agent 003 → Ollama Cloud (http://gateway-agent-003:9090).

####################################################################################
# GATEWAY
####################################################################################
# Gateway listen port. Default: 9090
#LISTEN_PORT=

# Log level for the gateway. Options: debug, info, warn, error. Default: info
LOG_LEVEL=debug

####################################################################################
# TRACKER
####################################################################################
# Tracker URL (http://rurdesk.proxy)
TRACKER_URL=http://rurdesk.proxy

# Token for the gateway to authenticate with the tracker.
# Obtained when creating bot user in the tracker. 
GATEWAY_TO_TRACKER_TOKEN=<agent-003: from-tracker-admin-ui>

# Token for the tracker to authenticate with the gateway.
# Obtained when creating bot user in the tracker.
TRACKER_TO_GATEWAY_TOKEN=<agent-003: hex-32-byte-token-shown-on-gateway-create>

####################################################################################
# GOOSE (AI AGENT)
####################################################################################
# Models this gateway lets the tracker pick, as provider/model. The first is the
# default unless MODEL_DEFAULT names another one.
MODELS=openai/glm-5.3,openai/kimi-k2.7-code,openai/mistral-large-4

#MODEL_DEFAULT=openai/kimi-k2.7-code

OPENAI_HOST=https://ollama.com

OPENAI_BASE_PATH=v1/chat/completions

OPENAI_API_KEY=<ollama-cloud-api-key>

# Highest turn limit the tracker may ask for. Unset means no ceiling.
#MAX_TURNS_LIMIT=1000
