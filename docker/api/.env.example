# Rurdesk API (tracker) configuration.

####################################################################################
# APPLICATION
####################################################################################
# Listen host.
APPLICATION_HOST=0.0.0.0

# Listen port. Serves REST + WebSocket + MCP (/mcp) + the SPA on one port (no separate MCP port).
APPLICATION_PORT=1000

# Serve the Angular build (production single-container only). Dev uses `ng serve`. Default: false
# SERVE_STATIC=true

# Directory of the compiled SPA when SERVE_STATIC=true.
# STATIC_DIR=/app/public

# Comma-separated origins the browser may call the API from. Unset means `*`,
# which is safe because auth is a bearer token and never a cookie — set this only
# if you want the browser to enforce a narrower set anyway.
# ALLOWED_ORIGINS=https://tracker.example.com

# The address people open in the browser, without a path. Used instead of the
# request's Host header, e.g. for the MCP endpoint URL. Leave unset to derive it
# from Host — correct whenever the proxy preserves Host (the shipped nginx config
# does). MCP_PUBLIC_BASE_URL is the older name and still works when this is unset.
# PUBLIC_BASE_URL=https://tracker.example.com

# Commercial build only. Encrypts the SSO client secret; generate it with
# `openssl rand -base64 32` and keep it with your backups.
# SSO_ENCRYPTION_KEY=

# Package the dev container builds. Set it to the commercial entrypoint to try
# paid features such as SSO locally.
# API_PACKAGE=./commercial/cmd/api

####################################################################################
# DATABASE
####################################################################################
# PostgreSQL host.
DATABASE_HOST=rurdesk-db

# PostgreSQL database name.
DATABASE_NAME=rurdesk

# PostgreSQL user.
DATABASE_USER=rurdesk

# PostgreSQL password. Required.
DATABASE_PASSWORD=rurdesk

####################################################################################
# CACHE
####################################################################################
# Redis host.
CACHE_HOST=rurdesk-cache

# Redis port.
CACHE_PORT=6379

# Redis database index.
CACHE_DB=0

# Redis password (empty if none).
CACHE_PASSWORD=

####################################################################################
# AI
####################################################################################
# Provider: anthropic, openai, gemini, ollama. (Ollama Cloud → use openai with AI_HOST=https://ollama.com.)
AI_PROVIDER=ollama

# Provider API key. Empty for local ollama.
AI_API_KEY=

# Model id. No code default — AI features are disabled until set.
AI_MODEL=qwen3-coder

# Base URL override. Required for ollama; optional for cloud providers.
AI_HOST=http://host.docker.internal:11434

# Separate model for quality checks. Falls back to AI_MODEL if unset.
AI_QUALITY_MODEL=

# Per-request timeout (s). Only the openai provider honors it; ≤0 uses 300. Others use fixed timeouts.
AI_TIMEOUT_SECONDS=

####################################################################################
# GIT
####################################################################################
# Encrypts stored git-integration tokens. Required. Generate: openssl rand -base64 32
GIT_INTEGRATION_ENCRYPTION_KEY=

####################################################################################
# TUNING
####################################################################################
# Max project-builder description length. Default: 10000
PROJECT_BUILDER_DESCRIPTION_MAX_LENGTH=10000

# WebSocket write deadline. Default: 10s
WEBSOCKET_WRITE_DEADLINE=10s
