FROM golang:1.27.3-alpine

# build-base provides gcc, which cgo (and therefore `go test -race`) requires.
RUN apk add --no-cache build-base

RUN go install github.com/pressly/goose/v3/cmd/goose@v3.26.0

# v2.15.0 is the current stable release; it requires Go 1.26+, so it builds on
# this image (Go 1.27.3). Keep in sync with ci.yml.
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0