# Goose gateway → Kimi K2.7 Code(http://gateway-goose-kimi-cloud:9090).

####################################################################################
# GATEWAY
####################################################################################
# Gateway listen port. Default: 9090
#LISTEN_PORT=

# Maximum number of concurrent requests the gateway will handle. Default: 1
# MAX_CONCURRENT=

# Log level for the gateway. Options: debug, info, warn, error. Default: info
LOG_LEVEL=debug

####################################################################################
# TRACKER
####################################################################################
# Tracker URL (http://rurdesk.proxy)
TRACKER_URL=http://rurdesk.proxy

# Token for the gateway to authenticate with the tracker.
# Obtained when creating bot user in the tracker. 
GATEWAY_TO_TRACKER_TOKEN=<bot-kimi: from-tracker-admin-ui>

# Token for the tracker to authenticate with the gateway.
# Obtained when creating bot user in the tracker.
TRACKER_TO_GATEWAY_TOKEN=<bot-kimi: hex-32-byte-token-shown-on-gateway-create>

####################################################################################
# GIT
####################################################################################
# Git repository URLs to clone for the bot to access. Multiple URLs can be
# specified, separated by commas. The bot will clone these repositories into its
REPO_URL=https://github.com/your-org/your-repo.git

# Personal access token / app token with contents read+write on `REPO_URL`. 
# Injected into the remote URL so the per-run agent can push branches back. 
# Only **push** is needed.
GIT_ACCESS_TOKEN=<git-pat>

####################################################################################
# GOOSE (AI AGENT)
####################################################################################
GOOSE_PROVIDER=openai
GOOSE_MODEL=kimi-k2.7-code
OPENAI_HOST=https://ollama.com
OPENAI_BASE_PATH=v1/chat/completions
OPENAI_API_KEY=<ollama-cloud-api-key>
GOOSE_MAX_TURNS_PLAN=50
GOOSE_MAX_TURNS_IMPLEMENT=100
