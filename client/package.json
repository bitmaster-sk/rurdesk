{
    "name": "issue-client",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --host 0.0.0.0 --port 1000",
        "build": "ng build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run test:unit && npm run test:ct",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:unit:watch": "vitest --config vitest.config.ts",
        "test:ct": "vitest run --config vitest.browser.config.ts",
        "test:ct:watch": "vitest --config vitest.browser.config.ts",
        "e2e": "playwright install chromium && playwright test",
        "e2e:stack": "playwright install chromium && node scripts/e2e-stack.mjs",
        "e2e:headed": "playwright install chromium && playwright test --headed",
        "e2e:ui": "playwright install chromium && playwright test --ui"
    },
    "private": true,
    "overrides": {
        "brace-expansion": "^5.0.8",
        "minimatch": "^10.2.5",
        "postcss": "^8.5.23",
        "@hono/node-server": "^2.0.5",
        "mermaid": {
            "uuid": "^14.0.1"
        },
        "sockjs": {
            "uuid": "^11.1.1"
        }
    },
    "dependencies": {
        "@angular/animations": "^21.2.18",
        "@angular/cdk": "^21.2.14",
        "@angular/common": "^21.0.0",
        "@angular/compiler": "^21.0.0",
        "@angular/core": "^21.0.0",
        "@angular/forms": "^21.2.18",
        "@angular/platform-browser": "^21.2.18",
        "@angular/platform-browser-dynamic": "^21.2.18",
        "@angular/router": "^21.2.18",
        "@fontsource/lato": "^5.2.7",
        "@fullcalendar/angular": "^6.1.16",
        "@fullcalendar/core": "^6.1.16",
        "@fullcalendar/daygrid": "^6.1.16",
        "@fullcalendar/interaction": "^6.1.16",
        "@fullcalendar/timegrid": "^6.1.16",
        "@ngx-translate/core": "17.0.0",
        "@ngx-translate/http-loader": "17.0.0",
        "@tabler/icons": "^3.41.1",
        "@tabler/icons-angular": "^3.41.1",
        "@types/d3": "^7.4.3",
        "chart.js": "^4.5.1",
        "d3": "^7.9.0",
        "date-fns": "^4.1.0",
        "diff2html": "^3.4.56",
        "emoji-toolkit": "^10.0.0",
        "flatpickr": "4.6.13",
        "lodash-es": "^4.17.21",
        "marked": "^17.0.2",
        "mind-elixir": "^1.1.4",
        "ng-click-outside2": "19.0.0",
        "ng2-charts": "^10.0.0",
        "ngx-markdown": "21.1.0",
        "rxjs": "^7.8.1",
        "tslib": "^2.8.1",
        "uuid": "14.0.2",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "^2.6.0",
        "@angular/build": "^21.2.19",
        "@angular/cli": "^21.0.0",
        "@angular/compiler-cli": "^21.0.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.60.0",
        "@tailwindcss/postcss": "^4.3.2",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.10.2",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "angular-eslint": "^21.4.0",
